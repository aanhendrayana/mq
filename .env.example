# =====================================================================
# Salin berkas ini menjadi .env.local, lalu sesuaikan nilainya.
# =====================================================================

# URL koneksi database PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/mq_ummina

# Kunci rahasia untuk enkripsi token sesi JWT (minimal 32 karakter)
AUTH_SECRET=ganti-dengan-rahasia-minimal-32-karakter-acak

# Alamat situs saat produksi (dipakai untuk metadata, tautan, dan QR sertifikat)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
