# =====================================================================
# Salin berkas ini menjadi .env.local, lalu isi nilainya.
# Ambil semua nilai di: Supabase Dashboard → Project Settings → API
# =====================================================================

# URL proyek Supabase, mis. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci "anon / public". Kunci ini AMAN terlihat di browser — pengamanan data
# dilakukan oleh RLS, bukan oleh kerahasiaan kunci ini.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci "service_role". MELEWATI SELURUH RLS.
# JANGAN pernah diawali NEXT_PUBLIC_, jangan di-commit, jangan dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Alamat situs saat produksi (dipakai untuk metadata OG, tautan email, dan QR
# pada sertifikat). Saat pengembangan lokal boleh dikosongkan.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
